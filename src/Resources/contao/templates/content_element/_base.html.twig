{% extends "@Contao/content_element/_base.html.twig" %}

{#  dump(data) #}
{#  dump(data["type"]) #}

{% if data["type"] == 'headline' or data["type"] == 'text' %}

    {# Add the grid classes #}
    {% set classes = '' %}

    {% set arrClasses = {
        'grid_xs': 'col-',
        'grid_sm': 'col-sm-',
        'grid_md': 'col-md-',
        'grid_lg': 'col-lg-',
        'grid_xl': 'col-xl-',
        'offset_xs': 'offset-',
        'offset_sm': 'offset-sm-',
        'offset_md': 'offset-md-',
        'offset_lg': 'offset-lg-',
        'offset_xl': 'offset-xl-',
        'order_xs': 'order-',
        'order_sm': 'order-sm-',
        'order_md': 'order-md-',
        'order_lg': 'order-lg-',
        'order_xl': 'order-xl-',
    } %}

    {% for key, value in arrClasses %}
        {% if data[key] and data[key] != '-1' %}
            {% set classes = classes ~ ' ' ~ value ~ data[key] %}
        {% endif %}
    {% endfor %}


    {% if data["col_valign"] != '' %}
        {% set classes = classes ~ ' ' ~ data["col_valign"] %}
    {% endif %}

    {% if data["col_align"] != '' %}
        {% set classes = classes ~ ' ' ~ ' center ' ~ data["col_align"] %}
    {% endif %}

    {% if data["col_margin"] != '' %}
        {% set classes = classes ~ ' ' ~ data["col_margin"] %}
    {% endif %}

    {% if data["col_padding"] != '' %}
        {% set classes = classes ~ ' ' ~ data["col_padding"] %}
    {% endif %}


    {# Orignal code
    if ('' !== $template->grid_visible) {
          $grid_visible = @unserialize((string) $template->grid_visible);

          if ('b:0;' === $grid_visible || false !== $grid_visible) {
              foreach (StringUtil::deserialize($template->grid_visible) as $value) {
                  $classes .= ' '.$value;
              }
          } else {
              $classes .= ' '.$template->grid_visible;
          }
      }
    #}

    {# ToDo: Fix array handling #}
    {% if data["grid_hidden"] != '' %}
        {% set grid_hidden = data["grid_hidden"]|deserialize %}
        {% dump(data["grid_hidden"]) %}
        {% if grid_hidden == 'b:0;' or grid_hidden is not same as(false) %}
            {% for value in data["grid_hidden"]|deserialize %}
                {% set classes = classes ~ ' ' ~ value %}
            {% endfor %}
        {% else %}
            {% set classes = classes ~ ' ' ~ data["grid_hidden"] %}
        {% endif %}
    {% endif %}

    {# ToDo: Fix array handling #}
    {% if data["grid_visible"] != '' %}
        {% set grid_visible = data["grid_visible"]|deserialize %}
        {% dump(data["grid_visible"]) %}
        {% if grid_visible == 'b:0;' or grid_visible is not same as(false) %}
            {% for value in data["grid_visible"]|deserialize %}
                {% set classes = classes ~ ' ' ~ value %}
            {% endfor %}
        {% else %}
            {% set classes = classes ~ ' ' ~ data["grid_visible"] %}
        {% endif %}
    {% endif %}

    {% set element_css_classes = classes %}

{% endif %}